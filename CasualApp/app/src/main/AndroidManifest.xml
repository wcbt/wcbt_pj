<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CasualApp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".JobListActivity"
            android:exported="false" />
            
        <activity
            android:name=".CreateJobActivity"
            android:exported="false" />
        <activity
            android:name=".CoordinatorHomeActivity"
            android:exported="false" />

        <activity
            android:name=".CoordinatorJobsActivity"
            android:exported="false" />

        <activity
            android:name=".CoordinatorApplicantsActivity"
            android:exported="false" />
        
        <activity
            android:name=".MyScheduleActivity"
            android:exported="false" />
            
        <activity android:name=".RegionSelectionActivity" />

        <activity android:name=".JobDetailActivity" />

        <activity android:name=".ConfirmApplyActivity" />

        <activity android:name=".ApplySuccessActivity" />

        <activity android:name=".MyJobsActivity" />

        <activity android:name=".MyJobsLandingActivity" />

        <activity
            android:name=".LanguageSettingsActivity"
            android:exported="false" />

    </application>

</manifest>